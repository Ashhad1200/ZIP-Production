// ─── Generator & Datasource ─────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  FINANCE_HEAD
  PRODUCTION_HEAD
  LOGISTICS_HEAD
  MARKETING_HEAD
  HR_HEAD
}

enum Shift {
  DAY
  NIGHT
}

enum GatePassStatus {
  CREATED
  DISPATCHED
  RECEIVED
}

enum OrderStatus {
  PENDING_APPROVAL
  PENDING
  ONGOING
  COMPLETED
}

enum ProductionStatus {
  IN_PRODUCTION
  COMPLETED
}

enum ApprovalStatus {
  AUTO_APPROVED
  PENDING
  APPROVED
  REJECTED
}

enum WorkerRole {
  HEAD_OPERATOR
  ASSISTANT
}

enum PaymentMode {
  CASH
  CHEQUE
  BANK_TRANSFER
}

enum PurchaseSource {
  CONTAINER
  SPOT_MARKET
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum NotificationType {
  ORDER_CREATED
  VOUCHER_APPROVAL
  LOW_STOCK
  GATE_PASS_RECEIVED
  ELECTRICITY_DISCREPANCY
}

enum AuditAction {
  CREATE
  UPDATE
  SOFT_DELETE
}

// ─── 1. User ────────────────────────────────────────────────────────────────

model User {
  id          String    @id @default(uuid())
  name        String    @unique
  role        Role
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  notifications Notification[]
  auditLogs     AuditLog[]

  // reverse relation for Voucher.approvedBy
  approvedVouchers Voucher[] @relation("VoucherApprover")

  @@map("users")
}

// ─── 2. Plant ───────────────────────────────────────────────────────────────

model Plant {
  id       String  @id @default(uuid())
  name     String  @unique
  location String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  machines          Machine[]
  productionEntries ProductionEntry[]
  workers           Worker[]
  scrapSales        ScrapSale[]

  @@index([isDeleted])
  @@map("plants")
}

// ─── 3. Machine ─────────────────────────────────────────────────────────────

model Machine {
  id                     String  @id @default(uuid())
  plantId                String
  identifier             String
  kwhRating              Decimal
  expectedOutputPerShift Int
  isActive               Boolean @default(true)

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  plant Plant @relation(fields: [plantId], references: [id])

  productionEntries ProductionEntry[]

  @@index([plantId])
  @@index([isDeleted])
  @@map("machines")
}

// ─── 4. Worker ──────────────────────────────────────────────────────────────

model Worker {
  id          String  @id @default(uuid())
  name        String
  designation String?
  plantId     String?
  isActive    Boolean @default(true)
  shiftCostPaisa BigInt? // per-shift labor cost for cost-price calculation

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  plant             Plant?                  @relation(fields: [plantId], references: [id])
  productionEntries ProductionEntryWorker[]
  salaryRates       WorkerSalaryRate[]
  payrollRecords    PayrollRecord[]
  advances          WorkerAdvance[]

  @@index([plantId])
  @@index([isDeleted])
  @@map("workers")
}

// ─── 5. ZipperVariant ───────────────────────────────────────────────────────

model ZipperVariant {
  id                    String  @id @default(uuid())
  code                  String  @unique
  name                  String
  description           String?
  standardGramsPerMeter Decimal
  metersPerCarton       Int?    // Standard meters per carton for inventory conversion (P-02)
  packagingMaterialId   String?
  recipeId              String?
  // grainTypeId is kept for backward compat but is now nullable.
  // Use the `ingredients` relation for multi-seed mixing.
  grainTypeId           String?
  isActive              Boolean @default(true)

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  grainType          GrainType?           @relation(fields: [grainTypeId], references: [id])
  packagingMaterial  PackagingMaterial?   @relation(fields: [packagingMaterialId], references: [id])
  recipe             Recipe?              @relation(fields: [recipeId], references: [id])
  ingredients        VariantIngredient[]
  productionEntries  ProductionEntry[]
  shiftVariants      ProductionShiftVariant[]
  gatePassLineItems  GatePassLineItem[]
  orderLineItems     OrderLineItem[]
  clientRates        ClientRate[]
  finishedGoodsStock FinishedGoodsStock?
  salesReturnLineItems SalesReturnLineItem[]

  @@index([packagingMaterialId])
  @@index([recipeId])
  @@index([grainTypeId])
  @@index([isDeleted])
  @@map("zipper_variants")
}

// ─── 5b. VariantIngredient (multi-seed mixing) ──────────────────────────────

model VariantIngredient {
  id           String  @id @default(uuid())
  variantId    String
  grainTypeId  String
  ratioPercent Decimal // 0-100; all rows for a variant must sum to 100

  variant   ZipperVariant @relation(fields: [variantId], references: [id])
  grainType GrainType     @relation(fields: [grainTypeId], references: [id])

  @@unique([variantId, grainTypeId])
  @@index([grainTypeId])
  @@map("variant_ingredients")
}

// ─── 5c. Recipe (reusable grain-mix formula) ────────────────────────────────

model Recipe {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  ingredients RecipeIngredient[]
  variants    ZipperVariant[]

  @@index([isDeleted])
  @@map("recipes")
}

model RecipeIngredient {
  id           String  @id @default(uuid())
  recipeId     String
  grainTypeId  String
  ratioPercent Decimal // 0-100; all rows for a recipe must sum to 100

  recipe    Recipe    @relation(fields: [recipeId], references: [id])
  grainType GrainType @relation(fields: [grainTypeId], references: [id])

  @@unique([recipeId, grainTypeId])
  @@index([grainTypeId])
  @@map("recipe_ingredients")
}

// ─── 6. GrainType ───────────────────────────────────────────────────────────

model GrainType {
  id                    String   @id @default(uuid())
  code                  String   @unique
  name                  String
  description           String?
  bagWeightGrams        Int      @default(25000)
  lowStockThresholdBags Decimal?
  isActive              Boolean  @default(true)

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  zipperVariants       ZipperVariant[]
  variantIngredients   VariantIngredient[]
  recipeIngredients    RecipeIngredient[]
  rawMaterialStock     RawMaterialStock?
  rawMaterialPurchases RawMaterialPurchase[]
  rawMaterialBatches   RawMaterialBatch[]

  @@index([isDeleted])
  @@map("grain_types")
}

// ─── 7. ProductionEntry ─────────────────────────────────────────────────────

model ProductionEntry {
  id                          String            @id @default(uuid())
  plantId                     String
  machineId                   String?           // which machine (3D Chakra / Glass Chakra)
  shift                       Shift
  date                        DateTime          @db.Date
  variantId                   String?
  status                      ProductionStatus  @default(IN_PRODUCTION)
  metersProduced              Int?
  gramsPerMeter               Decimal?
  electricityUnitsConsumed    Decimal?
  electricityStartReading     Decimal?
  electricityEndReading       Decimal?
  hasElectricityDiscrepancy   Boolean           @default(false)
  electricityDiscrepancyNotes String?
  scrapWeightGrams            Int?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  plant   Plant                        @relation(fields: [plantId], references: [id])
  machine Machine?                     @relation(fields: [machineId], references: [id])
  variant ZipperVariant?               @relation(fields: [variantId], references: [id])
  workers ProductionEntryWorker[]
  batchConsumptions ProductionBatchConsumption[]
  shiftVariants     ProductionShiftVariant[]

  // No unique constraint — multiple entries per shift are allowed (each entry = one variant run)
  @@index([plantId, shift, date])
  @@index([variantId])
  @@index([date])
  @@index([plantId, date])
  @@index([isDeleted])
  @@map("production_entries")
}

// ─── 7b. ProductionShiftVariant (per-variant data within a shift) ───────────

model ProductionShiftVariant {
  id               String   @id @default(uuid())
  entryId          String
  variantId        String
  metersProduced   Int      @default(0)
  gramsPerMeter    Decimal?
  scrapWeightGrams Int      @default(0)

  entry   ProductionEntry @relation(fields: [entryId], references: [id])
  variant ZipperVariant   @relation(fields: [variantId], references: [id])

  @@unique([entryId, variantId])
  @@index([entryId])
  @@index([variantId])
  @@map("production_shift_variants")
}

// ─── 8. ProductionEntryWorker (join table) ──────────────────────────────────

model ProductionEntryWorker {
  productionEntryId String
  workerId          String
  role              WorkerRole?       // HEAD_OPERATOR or ASSISTANT

  productionEntry ProductionEntry @relation(fields: [productionEntryId], references: [id])
  worker          Worker          @relation(fields: [workerId], references: [id])

  @@id([productionEntryId, workerId])
  @@index([workerId])
  @@map("production_entry_workers")
}

// ─── 9. ScrapSale ───────────────────────────────────────────────────────────

model ScrapSale {
  id               String   @id @default(uuid())
  date             DateTime @db.Date
  totalWeightKg    Decimal
  ratePerKgPaisa   BigInt
  totalAmountPaisa BigInt
  buyerName        String?
  plantId          String?
  journalEntryId   String?  @unique

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  plant        Plant?        @relation(fields: [plantId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([plantId])
  @@index([date])
  @@index([isDeleted])
  @@map("scrap_sales")
}

// ─── 10. RawMaterialPurchase ────────────────────────────────────────────────

model RawMaterialPurchase {
  id               String         @id @default(uuid())
  grainTypeId      String
  vendorId         String?        // Vendor who supplied this purchase (PU-01 + PU-02)
  numberOfBags     Decimal
  ratePerBagPaisa  BigInt
  totalAmountPaisa BigInt
  purchaseDate     DateTime       @db.Date
  source           PurchaseSource
  journalEntryId   String?        @unique

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  grainType    GrainType          @relation(fields: [grainTypeId], references: [id])
  vendor       Vendor?            @relation(fields: [vendorId], references: [id])
  journalEntry JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  batch        RawMaterialBatch?

  @@index([grainTypeId])
  @@index([vendorId])
  @@index([purchaseDate])
  @@index([isDeleted])
  @@map("raw_material_purchases")
}

// ─── 10a. Vendor (grain bag suppliers) ─────────────────────────────────────

model Vendor {
  id          String  @id @default(uuid())
  name        String  @unique
  contactName String?
  phone       String?
  address     String?
  grainTypes  String? // Comma-separated grain type codes they supply
  isActive    Boolean @default(true)

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  purchases RawMaterialPurchase[]

  @@index([isDeleted])
  @@map("vendors")
}

// ─── 10b. RawMaterialBatch (FIFO batch costing) ────────────────────────────

model RawMaterialBatch {
  id               String         @id @default(uuid())
  grainTypeId      String
  purchaseId       String         @unique
  bagsTotal        Decimal
  bagsRemaining    Decimal
  pricePerBagPaisa BigInt
  purchaseDate     DateTime       @db.Date
  source           PurchaseSource
  isExhausted      Boolean        @default(false)

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt

  grainType    GrainType                     @relation(fields: [grainTypeId], references: [id])
  purchase     RawMaterialPurchase           @relation(fields: [purchaseId], references: [id])
  consumptions ProductionBatchConsumption[]

  @@index([grainTypeId])
  @@index([grainTypeId, isExhausted])
  @@index([purchaseDate])
  @@map("raw_material_batches")
}

// ─── 10c. ProductionBatchConsumption (FIFO cost tracking per production) ──

model ProductionBatchConsumption {
  id                String  @id @default(uuid())
  productionEntryId String
  batchId           String
  bagsConsumed      Decimal
  totalCostPaisa    BigInt

  productionEntry ProductionEntry  @relation(fields: [productionEntryId], references: [id])
  batch           RawMaterialBatch @relation(fields: [batchId], references: [id])

  @@index([productionEntryId])
  @@index([batchId])
  @@map("production_batch_consumptions")
}

// ─── 10d. ElectricityRate (historical rates for cost price calculation) ───

model ElectricityRate {
  id               String    @id @default(uuid())
  ratePaisaPerUnit BigInt
  effectiveFrom    DateTime  @db.Date
  effectiveTo      DateTime? @db.Date
  notes            String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt

  @@index([effectiveFrom])
  @@map("electricity_rates")
}

// ─── 11. RawMaterialStock ───────────────────────────────────────────────────

model RawMaterialStock {
  id          String  @id @default(uuid())
  grainTypeId String  @unique
  currentBags Decimal

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  grainType GrainType @relation(fields: [grainTypeId], references: [id])

  @@index([updatedAt])
  @@map("raw_material_stock")
}

// ─── 12. FinishedGoodsStock ─────────────────────────────────────────────────

model FinishedGoodsStock {
  id                String @id @default(uuid())
  variantId         String @unique
  currentMeters     Int
  lowStockThreshold Int?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  variant ZipperVariant @relation(fields: [variantId], references: [id])

  @@index([updatedAt])
  @@map("finished_goods_stock")
}

// ─── 13. Client ─────────────────────────────────────────────────────────────

model Client {
  id                  String  @id @default(uuid())
  name                String  @unique
  contactPerson       String?
  phone               String?
  address             String?
  paymentCycleDays    Int     @default(30)
  accountId           String? @unique
  openingBalancePaisa BigInt  @default(0) // Day-0 outstanding balance (F-01)

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  gatePasses        GatePass[]
  orders            Order[]
  clientRates       ClientRate[]
  journalEntryLines JournalEntryLine[]
  salesReturns      SalesReturn[]
  account           Account?           @relation(fields: [accountId], references: [id])

  @@index([isDeleted])
  @@map("clients")
}

// ─── 14. ClientRate ─────────────────────────────────────────────────────────

model ClientRate {
  id                String    @id @default(uuid())
  clientId          String
  variantId         String
  ratePerMeterPaisa BigInt
  effectiveFrom     DateTime
  effectiveTo       DateTime?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  client  Client        @relation(fields: [clientId], references: [id])
  variant ZipperVariant @relation(fields: [variantId], references: [id])

  @@index([clientId])
  @@index([variantId])
  @@index([isDeleted])
  @@map("client_rates")
}

// ─── 15. GatePass ───────────────────────────────────────────────────────────

model GatePass {
  id                   String         @id @default(uuid())
  gatePassNumber       String         @unique
  clientId             String
  date                 DateTime       @db.Date
  issuingManagerName   String
  shift                Shift
  status               GatePassStatus @default(CREATED)
  orderId              String?
  verifyToken          String         @unique
  verifyTokenExpiresAt DateTime
  receivedAt           DateTime?
  receivedBy           String?
  receiptPhotoUrl      String?
  totalAmountPaisa     BigInt
  paymentDueDate       DateTime       @db.Date
  journalEntryId       String?        @unique

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  client        Client              @relation(fields: [clientId], references: [id])
  order         Order?              @relation(fields: [orderId], references: [id])
  lineItems     GatePassLineItem[]
  salesReturns  SalesReturn[]
  journalEntry  JournalEntry?       @relation(fields: [journalEntryId], references: [id])

  @@index([clientId])
  @@index([orderId])
  @@index([status])
  @@index([date])
  @@index([clientId, date])
  @@index([isDeleted])
  @@map("gate_passes")
}

// ─── 16. GatePassLineItem ───────────────────────────────────────────────────

model GatePassLineItem {
  id                String @id @default(uuid())
  gatePassId        String
  variantId         String
  meters            Int
  ratePerMeterPaisa BigInt
  lineAmountPaisa   BigInt

  gatePass GatePass      @relation(fields: [gatePassId], references: [id])
  variant  ZipperVariant @relation(fields: [variantId], references: [id])
  salesReturnLineItems SalesReturnLineItem[]

  @@index([gatePassId])
  @@index([variantId])
  @@map("gate_pass_line_items")
}

// ─── 16b. SalesReturn ────────────────────────────────────────────────────────

model SalesReturn {
  id               String   @id @default(uuid())
  returnNumber     String   @unique
  gatePassId       String
  clientId         String
  date             DateTime @db.Date
  reason           String?
  totalAmountPaisa BigInt
  journalEntryId   String?  @unique

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt

  gatePass     GatePass              @relation(fields: [gatePassId], references: [id])
  client       Client                @relation(fields: [clientId], references: [id])
  journalEntry JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  lineItems    SalesReturnLineItem[]

  @@index([gatePassId])
  @@index([clientId])
  @@index([date])
  @@map("sales_returns")
}

model SalesReturnLineItem {
  id                 String @id @default(uuid())
  salesReturnId      String
  gatePassLineItemId String
  variantId          String
  metersReturned     Int
  ratePerMeterPaisa  BigInt
  lineAmountPaisa    BigInt

  salesReturn      SalesReturn      @relation(fields: [salesReturnId], references: [id])
  gatePassLineItem GatePassLineItem @relation(fields: [gatePassLineItemId], references: [id])
  variant          ZipperVariant    @relation(fields: [variantId], references: [id])

  @@index([salesReturnId])
  @@index([gatePassLineItemId])
  @@index([variantId])
  @@map("sales_return_line_items")
}

// ─── 17. Order ──────────────────────────────────────────────────────────────

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  clientId          String
  metersOrdered     Int
  totalAmountPaisa  BigInt
  deliveryDeadline  DateTime    @db.Date
  metersDelivered   Int         @default(0)
  status            OrderStatus @default(PENDING)

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  client     Client          @relation(fields: [clientId], references: [id])
  lineItems  OrderLineItem[]
  gatePasses GatePass[]

  @@index([clientId])
  @@index([status])
  @@index([clientId, status])
  @@index([isDeleted])
  @@map("orders")
}

model OrderLineItem {
  id                String @id @default(uuid())
  orderId           String
  variantId         String
  metersOrdered     Int
  metersDelivered   Int    @default(0)
  ratePerMeterPaisa BigInt

  order   Order         @relation(fields: [orderId], references: [id])
  variant ZipperVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("order_line_items")
}

// ─── 18. Account ────────────────────────────────────────────────────────────

model Account {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  accountType AccountType
  parentId    String?
  isGroup     Boolean     @default(false)
  isActive    Boolean     @default(true)

  parent            Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children          Account[]          @relation("AccountHierarchy")
  journalEntryLines JournalEntryLine[]
  client            Client?

  @@index([parentId])
  @@index([accountType])
  @@map("accounts")
}

// ─── 19. JournalEntry ───────────────────────────────────────────────────────

model JournalEntry {
  id            String             @id @default(uuid())
  entryNumber   String             @unique
  entryDate     DateTime           @db.Date
  description   String?
  status        JournalEntryStatus @default(DRAFT)
  referenceType String?
  referenceId   String?
  postedAt      DateTime?
  postedBy      String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  lines               JournalEntryLine[]
  gatePass            GatePass?
  voucher             Voucher?
  scrapSale           ScrapSale?
  rawMaterialPurchase RawMaterialPurchase?
  payrollRecord       PayrollRecord?
  salesReturn         SalesReturn?

  @@index([entryDate])
  @@index([status])
  @@index([isDeleted])
  @@map("journal_entries")
}

// ─── 20. JournalEntryLine ───────────────────────────────────────────────────

model JournalEntryLine {
  id                String  @id @default(uuid())
  entryId           String
  accountId         String
  clientId          String?
  description       String?
  debitAmountPaisa  BigInt  @default(0)
  creditAmountPaisa BigInt  @default(0)
  lineOrder         Int     @default(0)

  entry   JournalEntry @relation(fields: [entryId], references: [id])
  account Account      @relation(fields: [accountId], references: [id])
  client  Client?      @relation(fields: [clientId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@index([clientId])
  @@map("journal_entry_lines")
}

// ─── 21. Voucher ────────────────────────────────────────────────────────────

model Voucher {
  id              String         @id @default(uuid())
  voucherNumber   String         @unique
  title           String
  description     String?
  date            DateTime       @db.Date
  amountPaisa     BigInt
  categoryId      String
  paymentMode     PaymentMode
  chequeNumber    String?
  companyId       String
  approvalStatus  ApprovalStatus
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  journalEntryId  String?        @unique

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  company      Company         @relation(fields: [companyId], references: [id])
  journalEntry JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  approver     User?           @relation("VoucherApprover", fields: [approvedBy], references: [id])

  @@index([categoryId])
  @@index([companyId])
  @@index([approvalStatus])
  @@index([date])
  @@index([isDeleted])
  @@map("vouchers")
}

// ─── 22. ExpenseCategory ────────────────────────────────────────────────────

model ExpenseCategory {
  id       String  @id @default(uuid())
  name     String
  parentId String?
  isActive Boolean @default(true)

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  parent   ExpenseCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ExpenseCategory[] @relation("CategoryHierarchy")
  vouchers Voucher[]

  @@index([parentId])
  @@index([isDeleted])
  @@map("expense_categories")
}

// ─── 23. Company ────────────────────────────────────────────────────────────

model Company {
  id           String  @id @default(uuid())
  name         String  @unique
  taxStructure String?
  isActive     Boolean @default(true)

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  vouchers Voucher[]

  @@index([isDeleted])
  @@map("companies")
}

// ─── 24. Notification ───────────────────────────────────────────────────────

model Notification {
  id              String           @id @default(uuid())
  recipientUserId String?
  recipientRole   Role?
  type            NotificationType
  title           String
  message         String
  referenceType   String?
  referenceId     String?
  isRead          Boolean          @default(false)
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  recipient User? @relation(fields: [recipientUserId], references: [id])

  @@index([recipientUserId])
  @@index([recipientRole])
  @@index([isRead])
  @@index([recipientUserId, isRead])
  @@map("notifications")
}

// ─── 25. AuditLog ───────────────────────────────────────────────────────────

model AuditLog {
  id            String      @id @default(uuid())
  entityType    String
  entityId      String
  action        AuditAction
  previousValue Json?
  newValue      Json
  changedFields String[]
  userId        String
  reason        String?
  timestamp     DateTime    @default(now())
  ipAddress     String?

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ─── 26. SystemSetting ──────────────────────────────────────────────────────

model SystemSetting {
  id          String  @id @default(uuid())
  key         String  @unique
  value       String
  description String?

  @@map("system_settings")
}

// ─── 27. WorkerSalaryRate ────────────────────────────────────────────────────

model WorkerSalaryRate {
  id                  String   @id @default(uuid())
  workerId            String
  monthlySalaryPaisa  BigInt
  effectiveFrom       DateTime
  isActive            Boolean  @default(true)

  createdBy String
  createdAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@map("worker_salary_rates")
}

// ─── 28. WorkerAdvance ───────────────────────────────────────────────────────

model WorkerAdvance {
  id          String   @id @default(uuid())
  workerId    String
  amountPaisa BigInt
  date        DateTime
  reason      String?
  isRecovered Boolean  @default(false)
  recoveredAt DateTime?

  createdBy String
  createdAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@map("worker_advances")
}

// ─── 29. PayrollRecord ───────────────────────────────────────────────────────

model PayrollRecord {
  id                    String      @id @default(uuid())
  month                 Int
  year                  Int
  workerId              String
  grossSalaryPaisa      BigInt
  advanceDeductionPaisa BigInt      @default(0)
  deductionsPaisa       BigInt      @default(0)
  netSalaryPaisa        BigInt
  paymentMode           PaymentMode @default(CASH)
  chequeNumber          String?
  journalEntryId        String?     @unique
  notes                 String?

  createdBy String
  createdAt DateTime @default(now())

  worker       Worker        @relation(fields: [workerId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@unique([workerId, month, year])
  @@index([year, month])
  @@map("payroll_records")
}

// ─── 30. MonthlyOverhead ─────────────────────────────────────────────────────
model MonthlyOverhead {
  id                  String   @id @default(uuid())
  year                Int
  month               Int      // 1-12
  laborPaisa          BigInt   @default(0)
  rentPaisa           BigInt   @default(0)
  transportationPaisa BigInt   @default(0)
  packingPaisa        BigInt   @default(0)
  miscellaneousPaisa  BigInt   @default(0)
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
  @@index([year, month])
  @@map("monthly_overheads")
}


// ─── Packaging Inventory ────────────────────────────────────────────────────
model PackagingMaterial {
  id           String   @id @default(uuid())
  name         String
  unit         String   @default("pcs")  // pcs, rolls, kg, etc.
  currentStock Int      @default(0)
  ratePerUnitPaisa BigInt @default(0)
  lowStockThreshold Int?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  adjustments  PackagingStockAdjustment[]
  variants     ZipperVariant[]
  @@map("packaging_materials")
}

model PackagingStockAdjustment {
  id          String   @id @default(uuid())
  materialId  String
  quantity    Int      // positive = add, negative = use
  type        String   // PURCHASE, CONSUMPTION, ADJUSTMENT
  unitRatePaisa BigInt?
  totalCostPaisa BigInt?
  referenceType String?
  referenceId   String?
  notes       String?
  createdBy   String
  createdAt   DateTime @default(now())
  material    PackagingMaterial @relation(fields: [materialId], references: [id])
  @@index([materialId])
  @@index([referenceType, referenceId])
  @@map("packaging_stock_adjustments")
}
