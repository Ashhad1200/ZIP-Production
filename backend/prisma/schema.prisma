// ─── Generator & Datasource ─────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  FINANCE_HEAD
  PRODUCTION_HEAD
  LOGISTICS_HEAD
  MARKETING_HEAD
  HR_HEAD
}

enum Shift {
  DAY
  NIGHT
}

enum GatePassStatus {
  CREATED
  DISPATCHED
  RECEIVED
}

enum OrderStatus {
  PENDING_APPROVAL
  PENDING
  ONGOING
  COMPLETED
}

enum ProductionStatus {
  IN_PRODUCTION
  COMPLETED
}

enum ApprovalStatus {
  AUTO_APPROVED
  PENDING
  APPROVED
  REJECTED
}

enum WorkerRole {
  HEAD_OPERATOR
  ASSISTANT
}

enum PaymentMode {
  CASH
  CHEQUE
  BANK_TRANSFER
}

enum PurchaseSource {
  CONTAINER
  SPOT_MARKET
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum NotificationType {
  ORDER_CREATED
  VOUCHER_APPROVAL
  LOW_STOCK
  GATE_PASS_RECEIVED
  ELECTRICITY_DISCREPANCY
}

enum AuditAction {
  CREATE
  UPDATE
  SOFT_DELETE
}

// ─── Platform / SaaS billing enums ─────────────────────────────────────────

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum PaymentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ─── 1. User ────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  name         String
  // Nullable during migration: pre-existing kiosk-mode rows have neither.
  // Both are required at the application layer for every new user going forward.
  email        String?   @unique
  passwordHash String?
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  // Nullable during Phase 1: existing single-tenant rows have no organization.
  // Phase 2 backfills this to a default Organization and makes it required.
  organizationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization? @relation(fields: [organizationId], references: [id])
  notifications Notification[]
  auditLogs     AuditLog[]

  // reverse relation for Voucher.approvedBy
  approvedVouchers Voucher[] @relation("VoucherApprover")

  @@index([organizationId])
  @@map("users")
}

// ─── 2. Plant ───────────────────────────────────────────────────────────────

model Plant {
  id             String  @id @default(uuid())
  name           String
  location       String?
  organizationId String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  organization      Organization?     @relation(fields: [organizationId], references: [id])
  machines          Machine[]
  productionEntries ProductionEntry[]
  workers           Worker[]
  scrapSales        ScrapSale[]

  @@unique([organizationId, name])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("plants")
}

// ─── 3. Machine ─────────────────────────────────────────────────────────────

model Machine {
  id                     String  @id @default(uuid())
  plantId                String
  identifier             String
  kwhRating              Decimal
  expectedOutputPerShift Int
  isActive               Boolean @default(true)
  organizationId         String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  plant        Plant         @relation(fields: [plantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  productionEntries ProductionEntry[]

  @@index([plantId])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("machines")
}

// ─── 4. Worker ──────────────────────────────────────────────────────────────

model Worker {
  id          String  @id @default(uuid())
  name        String
  designation String?
  plantId     String?
  isActive    Boolean @default(true)
  shiftCostPaisa BigInt? // per-shift labor cost for cost-price calculation
  organizationId String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  plant             Plant?                  @relation(fields: [plantId], references: [id])
  organization      Organization?           @relation(fields: [organizationId], references: [id])
  productionEntries ProductionEntryWorker[]
  salaryRates       WorkerSalaryRate[]
  payrollRecords    PayrollRecord[]
  advances          WorkerAdvance[]

  @@index([plantId])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("workers")
}

// ─── 5. ProductVariant ───────────────────────────────────────────────────────

model ProductVariant {
  id                    String  @id @default(uuid())
  code                  String
  name                  String
  description           String?
  standardConsumptionRatio Decimal @map("standardGramsPerMeter") // raw-material consumed per unit of output (default vertical: grams per meter)
  metersPerCarton       Int?    // Standard meters per carton for inventory conversion (P-02)
  packagingMaterialId   String?
  recipeId              String?
  // rawMaterialTypeId is kept for backward compat but is now nullable.
  // Use the `ingredients` relation for multi-seed mixing.
  rawMaterialTypeId           String?  @map("grainTypeId")
  isActive              Boolean @default(true)
  organizationId        String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  rawMaterialType          RawMaterialType?           @relation(fields: [rawMaterialTypeId], references: [id])
  packagingMaterial  PackagingMaterial?   @relation(fields: [packagingMaterialId], references: [id])
  recipe             Recipe?              @relation(fields: [recipeId], references: [id])
  organization       Organization?        @relation(fields: [organizationId], references: [id])
  ingredients        VariantIngredient[]
  productionEntries  ProductionEntry[]
  shiftVariants      ProductionShiftVariant[]
  gatePassLineItems  GatePassLineItem[]
  orderLineItems     OrderLineItem[]
  clientRates        ClientRate[]
  finishedGoodsStock FinishedGoodsStock?
  salesReturnLineItems SalesReturnLineItem[]

  @@unique([organizationId, code])
  @@index([packagingMaterialId])
  @@index([recipeId])
  @@index([rawMaterialTypeId])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("zipper_variants")
}

// ─── 5b. VariantIngredient (multi-seed mixing) ──────────────────────────────

model VariantIngredient {
  id           String  @id @default(uuid())
  variantId    String
  rawMaterialTypeId  String  @map("grainTypeId")
  ratioPercent Decimal // 0-100; all rows for a variant must sum to 100

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  rawMaterialType RawMaterialType     @relation(fields: [rawMaterialTypeId], references: [id])

  @@unique([variantId, rawMaterialTypeId])
  @@index([rawMaterialTypeId])
  @@map("variant_ingredients")
}

// ─── 5c. Recipe (reusable grain-mix formula) ────────────────────────────────

model Recipe {
  id             String  @id @default(uuid())
  name           String
  description    String?
  isActive       Boolean @default(true)
  organizationId String?

  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  organization Organization?      @relation(fields: [organizationId], references: [id])
  ingredients  RecipeIngredient[]
  variants     ProductVariant[]

  @@unique([organizationId, name])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("recipes")
}

model RecipeIngredient {
  id           String  @id @default(uuid())
  recipeId     String
  rawMaterialTypeId  String  @map("grainTypeId")
  ratioPercent Decimal // 0-100; all rows for a recipe must sum to 100

  recipe    Recipe    @relation(fields: [recipeId], references: [id])
  rawMaterialType RawMaterialType @relation(fields: [rawMaterialTypeId], references: [id])

  @@unique([recipeId, rawMaterialTypeId])
  @@index([rawMaterialTypeId])
  @@map("recipe_ingredients")
}

// ─── 6. RawMaterialType ───────────────────────────────────────────────────────────

model RawMaterialType {
  id                    String   @id @default(uuid())
  code                  String
  name                  String
  description           String?
  bagWeightGrams        Int      @default(25000)
  lowStockThresholdBags Decimal?
  isActive              Boolean  @default(true)
  organizationId        String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  organization         Organization?          @relation(fields: [organizationId], references: [id])
  productVariants       ProductVariant[]
  variantIngredients   VariantIngredient[]
  recipeIngredients    RecipeIngredient[]
  rawMaterialStock     RawMaterialStock?
  rawMaterialPurchases RawMaterialPurchase[]
  rawMaterialBatches   RawMaterialBatch[]

  @@unique([organizationId, code])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("grain_types")
}

// ─── 7. ProductionEntry ─────────────────────────────────────────────────────

model ProductionEntry {
  id                          String            @id @default(uuid())
  plantId                     String
  machineId                   String?           // which machine (3D Chakra / Glass Chakra)
  shift                       Shift
  date                        DateTime          @db.Date
  variantId                   String?
  status                      ProductionStatus  @default(IN_PRODUCTION)
  metersProduced              Int?
  gramsPerMeter               Decimal?
  electricityUnitsConsumed    Decimal?
  electricityStartReading     Decimal?
  electricityEndReading       Decimal?
  hasElectricityDiscrepancy   Boolean           @default(false)
  electricityDiscrepancyNotes String?
  scrapWeightGrams            Int?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  plant   Plant                        @relation(fields: [plantId], references: [id])
  machine Machine?                     @relation(fields: [machineId], references: [id])
  variant ProductVariant?               @relation(fields: [variantId], references: [id])
  workers ProductionEntryWorker[]
  batchConsumptions ProductionBatchConsumption[]
  shiftVariants     ProductionShiftVariant[]

  // No unique constraint — multiple entries per shift are allowed (each entry = one variant run)
  @@index([plantId, shift, date])
  @@index([variantId])
  @@index([date])
  @@index([plantId, date])
  @@index([isDeleted])
  @@map("production_entries")
}

// ─── 7b. ProductionShiftVariant (per-variant data within a shift) ───────────

model ProductionShiftVariant {
  id               String   @id @default(uuid())
  entryId          String
  variantId        String
  metersProduced   Int      @default(0)
  gramsPerMeter    Decimal?
  scrapWeightGrams Int      @default(0)

  entry   ProductionEntry @relation(fields: [entryId], references: [id])
  variant ProductVariant   @relation(fields: [variantId], references: [id])

  @@unique([entryId, variantId])
  @@index([entryId])
  @@index([variantId])
  @@map("production_shift_variants")
}

// ─── 8. ProductionEntryWorker (join table) ──────────────────────────────────

model ProductionEntryWorker {
  productionEntryId String
  workerId          String
  role              WorkerRole?       // HEAD_OPERATOR or ASSISTANT

  productionEntry ProductionEntry @relation(fields: [productionEntryId], references: [id])
  worker          Worker          @relation(fields: [workerId], references: [id])

  @@id([productionEntryId, workerId])
  @@index([workerId])
  @@map("production_entry_workers")
}

// ─── 9. ScrapSale ───────────────────────────────────────────────────────────

model ScrapSale {
  id               String   @id @default(uuid())
  date             DateTime @db.Date
  totalWeightKg    Decimal
  ratePerKgPaisa   BigInt
  totalAmountPaisa BigInt
  buyerName        String?
  plantId          String?
  journalEntryId   String?  @unique
  organizationId   String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  plant        Plant?        @relation(fields: [plantId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([plantId])
  @@index([date])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("scrap_sales")
}

// ─── 10. RawMaterialPurchase ────────────────────────────────────────────────

model RawMaterialPurchase {
  id               String         @id @default(uuid())
  rawMaterialTypeId      String  @map("grainTypeId")
  vendorId         String?        // Vendor who supplied this purchase (PU-01 + PU-02)
  numberOfBags     Decimal
  ratePerBagPaisa  BigInt
  totalAmountPaisa BigInt
  purchaseDate     DateTime       @db.Date
  source           PurchaseSource
  journalEntryId   String?        @unique
  organizationId   String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  rawMaterialType    RawMaterialType          @relation(fields: [rawMaterialTypeId], references: [id])
  vendor       Vendor?            @relation(fields: [vendorId], references: [id])
  journalEntry JournalEntry?      @relation(fields: [journalEntryId], references: [id])
  organization Organization?      @relation(fields: [organizationId], references: [id])
  batch        RawMaterialBatch?

  @@index([rawMaterialTypeId])
  @@index([vendorId])
  @@index([purchaseDate])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("raw_material_purchases")
}

// ─── 10a. Vendor (grain bag suppliers) ─────────────────────────────────────

model Vendor {
  id             String  @id @default(uuid())
  name           String
  contactName    String?
  phone          String?
  address        String?
  rawMaterialTypes     String? // Comma-separated grain type codes they supply
  isActive       Boolean @default(true)
  organizationId String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  organization         Organization?               @relation(fields: [organizationId], references: [id])
  purchases            RawMaterialPurchase[]
  packagingAdjustments PackagingStockAdjustment[]

  @@unique([organizationId, name])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("vendors")
}

// ─── 10b. RawMaterialBatch (FIFO batch costing) ────────────────────────────

model RawMaterialBatch {
  id               String         @id @default(uuid())
  rawMaterialTypeId      String  @map("grainTypeId")
  purchaseId       String         @unique
  bagsTotal        Decimal
  bagsRemaining    Decimal
  pricePerBagPaisa BigInt
  purchaseDate     DateTime       @db.Date
  source           PurchaseSource
  isExhausted      Boolean        @default(false)
  organizationId   String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt

  rawMaterialType    RawMaterialType                     @relation(fields: [rawMaterialTypeId], references: [id])
  purchase     RawMaterialPurchase           @relation(fields: [purchaseId], references: [id])
  organization Organization?                 @relation(fields: [organizationId], references: [id])
  consumptions ProductionBatchConsumption[]

  @@index([rawMaterialTypeId])
  @@index([rawMaterialTypeId, isExhausted])
  @@index([purchaseDate])
  @@index([organizationId])
  @@map("raw_material_batches")
}

// ─── 10c. ProductionBatchConsumption (FIFO cost tracking per production) ──

model ProductionBatchConsumption {
  id                String  @id @default(uuid())
  productionEntryId String
  batchId           String
  bagsConsumed      Decimal
  totalCostPaisa    BigInt

  productionEntry ProductionEntry  @relation(fields: [productionEntryId], references: [id])
  batch           RawMaterialBatch @relation(fields: [batchId], references: [id])

  @@index([productionEntryId])
  @@index([batchId])
  @@map("production_batch_consumptions")
}

// ─── 10d. ElectricityRate (historical rates for cost price calculation) ───

model ElectricityRate {
  id               String    @id @default(uuid())
  ratePaisaPerUnit BigInt
  effectiveFrom    DateTime  @db.Date
  effectiveTo      DateTime? @db.Date
  notes            String?
  organizationId   String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([effectiveFrom])
  @@index([organizationId])
  @@map("electricity_rates")
}

// ─── 11. RawMaterialStock ───────────────────────────────────────────────────

model RawMaterialStock {
  id             String  @id @default(uuid())
  rawMaterialTypeId    String  @unique @map("grainTypeId")
  currentBags    Decimal
  organizationId String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  rawMaterialType    RawMaterialType     @relation(fields: [rawMaterialTypeId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([updatedAt])
  @@index([organizationId])
  @@map("raw_material_stock")
}

// ─── 12. FinishedGoodsStock ─────────────────────────────────────────────────

model FinishedGoodsStock {
  id                String @id @default(uuid())
  variantId         String @unique
  currentMeters     Int
  lowStockThreshold Int?
  organizationId    String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  variant      ProductVariant @relation(fields: [variantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([updatedAt])
  @@index([organizationId])
  @@map("finished_goods_stock")
}

// ─── 13. Client ─────────────────────────────────────────────────────────────

model Client {
  id                  String  @id @default(uuid())
  name                String
  contactPerson       String?
  phone               String?
  address             String?
  paymentCycleDays    Int     @default(30)
  accountId           String? @unique
  openingBalancePaisa BigInt  @default(0) // Day-0 outstanding balance (F-01)
  organizationId      String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  gatePasses        GatePass[]
  orders            Order[]
  clientRates       ClientRate[]
  journalEntryLines JournalEntryLine[]
  salesReturns      SalesReturn[]
  account           Account?           @relation(fields: [accountId], references: [id])
  organization      Organization?      @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("clients")
}

// ─── 14. ClientRate ─────────────────────────────────────────────────────────

model ClientRate {
  id                String    @id @default(uuid())
  clientId          String
  variantId         String
  ratePerMeterPaisa BigInt
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  organizationId    String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  client       Client        @relation(fields: [clientId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([clientId])
  @@index([variantId])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("client_rates")
}

// ─── 15. GatePass ───────────────────────────────────────────────────────────

model GatePass {
  id                   String         @id @default(uuid())
  gatePassNumber       String
  clientId             String
  date                 DateTime       @db.Date
  issuingManagerName   String
  shift                Shift
  status               GatePassStatus @default(CREATED)
  orderId              String?
  verifyToken          String         @unique
  verifyTokenExpiresAt DateTime
  receivedAt           DateTime?
  receivedBy           String?
  receiptPhotoUrl      String?
  totalAmountPaisa     BigInt
  paymentDueDate       DateTime       @db.Date
  journalEntryId       String?        @unique
  organizationId       String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  client        Client              @relation(fields: [clientId], references: [id])
  order         Order?              @relation(fields: [orderId], references: [id])
  organization  Organization?       @relation(fields: [organizationId], references: [id])
  lineItems     GatePassLineItem[]
  salesReturns  SalesReturn[]
  journalEntry  JournalEntry?       @relation(fields: [journalEntryId], references: [id])

  @@unique([organizationId, gatePassNumber])
  @@index([clientId])
  @@index([orderId])
  @@index([status])
  @@index([date])
  @@index([clientId, date])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("gate_passes")
}

// ─── 16. GatePassLineItem ───────────────────────────────────────────────────

model GatePassLineItem {
  id                String @id @default(uuid())
  gatePassId        String
  variantId         String
  meters            Int
  ratePerMeterPaisa BigInt
  lineAmountPaisa   BigInt

  gatePass GatePass      @relation(fields: [gatePassId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])
  salesReturnLineItems SalesReturnLineItem[]

  @@index([gatePassId])
  @@index([variantId])
  @@map("gate_pass_line_items")
}

// ─── 16b. SalesReturn ────────────────────────────────────────────────────────

model SalesReturn {
  id               String   @id @default(uuid())
  returnNumber     String
  gatePassId       String
  clientId         String
  date             DateTime @db.Date
  reason           String?
  totalAmountPaisa BigInt
  journalEntryId   String?  @unique
  organizationId   String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt

  gatePass     GatePass              @relation(fields: [gatePassId], references: [id])
  client       Client                @relation(fields: [clientId], references: [id])
  journalEntry JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  organization Organization?         @relation(fields: [organizationId], references: [id])
  lineItems    SalesReturnLineItem[]

  @@unique([organizationId, returnNumber])
  @@index([gatePassId])
  @@index([clientId])
  @@index([date])
  @@index([organizationId])
  @@map("sales_returns")
}

model SalesReturnLineItem {
  id                 String @id @default(uuid())
  salesReturnId      String
  gatePassLineItemId String
  variantId          String
  metersReturned     Int
  ratePerMeterPaisa  BigInt
  lineAmountPaisa    BigInt

  salesReturn      SalesReturn      @relation(fields: [salesReturnId], references: [id])
  gatePassLineItem GatePassLineItem @relation(fields: [gatePassLineItemId], references: [id])
  variant          ProductVariant    @relation(fields: [variantId], references: [id])

  @@index([salesReturnId])
  @@index([gatePassLineItemId])
  @@index([variantId])
  @@map("sales_return_line_items")
}

// ─── 17. Order ──────────────────────────────────────────────────────────────

model Order {
  id                String      @id @default(uuid())
  orderNumber       String
  clientId          String
  metersOrdered     Int
  totalAmountPaisa  BigInt
  deliveryDeadline  DateTime    @db.Date
  metersDelivered   Int         @default(0)
  status            OrderStatus @default(PENDING)
  organizationId    String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  client       Client          @relation(fields: [clientId], references: [id])
  organization Organization?   @relation(fields: [organizationId], references: [id])
  lineItems    OrderLineItem[]
  gatePasses   GatePass[]

  @@unique([organizationId, orderNumber])
  @@index([clientId])
  @@index([status])
  @@index([clientId, status])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("orders")
}

model OrderLineItem {
  id                String @id @default(uuid())
  orderId           String
  variantId         String
  metersOrdered     Int
  metersDelivered   Int    @default(0)
  ratePerMeterPaisa BigInt

  order   Order         @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("order_line_items")
}

// ─── 18. Account ────────────────────────────────────────────────────────────

model Account {
  id             String      @id @default(uuid())
  code           String
  name           String
  accountType    AccountType
  parentId       String?
  isGroup        Boolean     @default(false)
  isActive       Boolean     @default(true)
  organizationId String?

  parent            Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children          Account[]          @relation("AccountHierarchy")
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  journalEntryLines JournalEntryLine[]
  client            Client?

  @@unique([organizationId, code])
  @@index([parentId])
  @@index([accountType])
  @@index([organizationId])
  @@map("accounts")
}

// ─── 19. JournalEntry ───────────────────────────────────────────────────────

model JournalEntry {
  id             String             @id @default(uuid())
  entryNumber    String
  entryDate      DateTime           @db.Date
  description    String?
  status         JournalEntryStatus @default(DRAFT)
  referenceType  String?
  referenceId    String?
  postedAt       DateTime?
  postedBy       String?
  organizationId String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  organization        Organization?         @relation(fields: [organizationId], references: [id])
  lines               JournalEntryLine[]
  gatePass            GatePass?
  voucher             Voucher?
  scrapSale           ScrapSale?
  rawMaterialPurchase RawMaterialPurchase?
  payrollRecord       PayrollRecord?
  salesReturn         SalesReturn?

  @@unique([organizationId, entryNumber])
  @@index([entryDate])
  @@index([status])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("journal_entries")
}

// ─── 20. JournalEntryLine ───────────────────────────────────────────────────

model JournalEntryLine {
  id                String  @id @default(uuid())
  entryId           String
  accountId         String
  clientId          String?
  description       String?
  debitAmountPaisa  BigInt  @default(0)
  creditAmountPaisa BigInt  @default(0)
  lineOrder         Int     @default(0)

  entry   JournalEntry @relation(fields: [entryId], references: [id])
  account Account      @relation(fields: [accountId], references: [id])
  client  Client?      @relation(fields: [clientId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@index([clientId])
  @@map("journal_entry_lines")
}

// ─── 21. Voucher ────────────────────────────────────────────────────────────

model Voucher {
  id              String         @id @default(uuid())
  voucherNumber   String
  title           String
  description     String?
  date            DateTime       @db.Date
  amountPaisa     BigInt
  categoryId      String
  paymentMode     PaymentMode
  chequeNumber    String?
  companyId       String
  approvalStatus  ApprovalStatus
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  journalEntryId  String?        @unique
  organizationId  String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  company      Company         @relation(fields: [companyId], references: [id])
  journalEntry JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  approver     User?           @relation("VoucherApprover", fields: [approvedBy], references: [id])
  organization Organization?   @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, voucherNumber])
  @@index([categoryId])
  @@index([companyId])
  @@index([approvalStatus])
  @@index([date])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("vouchers")
}

// ─── 22. ExpenseCategory ────────────────────────────────────────────────────

model ExpenseCategory {
  id             String  @id @default(uuid())
  name           String
  parentId       String?
  isActive       Boolean @default(true)
  organizationId String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  parent       ExpenseCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     ExpenseCategory[] @relation("CategoryHierarchy")
  organization Organization?     @relation(fields: [organizationId], references: [id])
  vouchers     Voucher[]

  @@index([parentId])
  @@index([isDeleted])
  @@index([organizationId])
  @@map("expense_categories")
}

// ─── 23. Company ────────────────────────────────────────────────────────────

model Company {
  id           String  @id @default(uuid())
  name         String  @unique
  taxStructure String?
  isActive     Boolean @default(true)
  // Nullable during Phase 1. Once set, this Company counts against its
  // Organization's Plan.maxSubCompanies limit — see platform.service.ts.
  organizationId String?

  // audit fields
  createdBy String
  createdAt DateTime  @default(now())
  updatedBy String?
  updatedAt DateTime  @updatedAt
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  version   Int       @default(1)

  organization Organization? @relation(fields: [organizationId], references: [id])
  vouchers     Voucher[]

  @@index([isDeleted])
  @@index([organizationId])
  @@map("companies")
}

// ─── 24. Notification ───────────────────────────────────────────────────────

model Notification {
  id              String           @id @default(uuid())
  recipientUserId String?
  recipientRole   Role?
  type            NotificationType
  title           String
  message         String
  referenceType   String?
  referenceId     String?
  isRead          Boolean          @default(false)
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  organizationId  String?

  recipient    User?         @relation(fields: [recipientUserId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([recipientUserId])
  @@index([recipientRole])
  @@index([isRead])
  @@index([recipientUserId, isRead])
  @@index([organizationId])
  @@map("notifications")
}

// ─── 25. AuditLog ───────────────────────────────────────────────────────────

model AuditLog {
  id             String      @id @default(uuid())
  entityType     String
  entityId       String
  action         AuditAction
  previousValue  Json?
  newValue       Json
  changedFields  String[]
  userId         String
  reason         String?
  timestamp      DateTime    @default(now())
  ipAddress      String?
  organizationId String?

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
  @@index([organizationId])
  @@map("audit_logs")
}

// ─── 26. SystemSetting ──────────────────────────────────────────────────────

model SystemSetting {
  id             String  @id @default(uuid())
  key            String
  value          String
  description    String?
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("system_settings")
}

// ─── 27. WorkerSalaryRate ────────────────────────────────────────────────────

model WorkerSalaryRate {
  id                  String   @id @default(uuid())
  workerId            String
  monthlySalaryPaisa  BigInt
  effectiveFrom       DateTime
  isActive            Boolean  @default(true)

  createdBy String
  createdAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@map("worker_salary_rates")
}

// ─── 28. WorkerAdvance ───────────────────────────────────────────────────────

model WorkerAdvance {
  id          String   @id @default(uuid())
  workerId    String
  amountPaisa BigInt
  date        DateTime
  reason      String?
  isRecovered Boolean  @default(false)
  recoveredAt DateTime?

  createdBy String
  createdAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@map("worker_advances")
}

// ─── 29. PayrollRecord ───────────────────────────────────────────────────────

model PayrollRecord {
  id                    String      @id @default(uuid())
  month                 Int
  year                  Int
  workerId              String
  grossSalaryPaisa      BigInt
  advanceDeductionPaisa BigInt      @default(0)
  deductionsPaisa       BigInt      @default(0)
  netSalaryPaisa        BigInt
  paymentMode           PaymentMode @default(CASH)
  chequeNumber          String?
  journalEntryId        String?     @unique
  notes                 String?
  organizationId        String?

  createdBy String
  createdAt DateTime @default(now())

  worker       Worker        @relation(fields: [workerId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([workerId, month, year])
  @@index([year, month])
  @@index([organizationId])
  @@map("payroll_records")
}

// ─── 30. MonthlyOverhead ─────────────────────────────────────────────────────
model MonthlyOverhead {
  id                  String   @id @default(uuid())
  year                Int
  month               Int      // 1-12
  laborPaisa          BigInt   @default(0)
  rentPaisa           BigInt   @default(0)
  transportationPaisa BigInt   @default(0)
  packingPaisa        BigInt   @default(0)
  miscellaneousPaisa  BigInt   @default(0)
  notes               String?
  organizationId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, year, month])
  @@index([year, month])
  @@index([organizationId])
  @@map("monthly_overheads")
}


// ─── Packaging Inventory ────────────────────────────────────────────────────
model PackagingMaterial {
  id           String   @id @default(uuid())
  name         String
  unit         String   @default("pcs")  // pcs, rolls, kg, etc.
  currentStock Int      @default(0)
  ratePerUnitPaisa BigInt @default(0)
  lowStockThreshold Int?
  notes        String?
  isActive     Boolean  @default(true)
  organizationId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  organization Organization? @relation(fields: [organizationId], references: [id])
  adjustments  PackagingStockAdjustment[]
  variants     ProductVariant[]
  @@index([organizationId])
  @@map("packaging_materials")
}

model PackagingStockAdjustment {
  id          String   @id @default(uuid())
  materialId  String
  quantity    Int      // positive = add, negative = use
  type        String   // PURCHASE, CONSUMPTION, ADJUSTMENT
  unitRatePaisa BigInt?
  totalCostPaisa BigInt?
  vendorId    String?
  purchaseDate DateTime?
  referenceType String?
  referenceId   String?
  notes       String?
  organizationId String?
  createdBy   String
  createdAt   DateTime @default(now())
  material    PackagingMaterial @relation(fields: [materialId], references: [id])
  vendor      Vendor?           @relation(fields: [vendorId], references: [id])
  organization Organization?    @relation(fields: [organizationId], references: [id])
  @@index([materialId])
  @@index([referenceType, referenceId])
  @@index([organizationId])
  @@map("packaging_stock_adjustments")
}

// ═══════════════════════════════════════════════════════════════════════════
// Platform plane — multi-tenant SaaS billing & backoffice (Phase 1)
//
// These models are additive and are NOT yet consumed by the tenant-facing
// modules above (Production, Inventory, Gate Pass, etc.) — see
// docs/SAAS-PLATFORM-BLUEPRINT.md Phase 2 for the plan to scope every
// tenant model by organizationId. This layer only powers the new
// /api/v1/platform/* backoffice + signup/billing endpoints.
// ═══════════════════════════════════════════════════════════════════════════

// ─── Organization (tenant / paying customer) ───────────────────────────────

model Organization {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  contactName  String
  contactEmail String             @unique
  contactPhone String?
  industry     String?
  status       OrganizationStatus @default(TRIAL)
  trialEndsAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  companies     Company[]
  subscriptions Subscription[]
  payments      Payment[]

  // Tenant-scoped business data (Phase 2 — see docs/SAAS-PLATFORM-BLUEPRINT.md)
  plants                Plant[]
  machines              Machine[]
  workers               Worker[]
  productVariants        ProductVariant[]
  recipes               Recipe[]
  rawMaterialTypes            RawMaterialType[]
  scrapSales            ScrapSale[]
  rawMaterialPurchases  RawMaterialPurchase[]
  vendors               Vendor[]
  rawMaterialBatches    RawMaterialBatch[]
  electricityRates      ElectricityRate[]
  rawMaterialStocks     RawMaterialStock[]
  finishedGoodsStocks   FinishedGoodsStock[]
  clients               Client[]
  clientRates           ClientRate[]
  gatePasses            GatePass[]
  salesReturns          SalesReturn[]
  orders                Order[]
  accounts              Account[]
  journalEntries        JournalEntry[]
  vouchers              Voucher[]
  expenseCategories     ExpenseCategory[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  systemSettings        SystemSetting[]
  payrollRecords        PayrollRecord[]
  monthlyOverheads      MonthlyOverhead[]
  packagingMaterials    PackagingMaterial[]
  packagingAdjustments  PackagingStockAdjustment[]

  @@index([status])
  @@map("organizations")
}

// ─── Module (sellable feature bundle unit) ─────────────────────────────────

model Module {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  planModules PlanModule[]

  @@map("modules")
}

// ─── Plan (price + modules + sub-company limit) ────────────────────────────

model Plan {
  id               String  @id @default(uuid())
  name             String  @unique
  code             String  @unique
  pricePaisa       BigInt
  billingCycleDays Int     @default(30)
  trialDays        Int     @default(3)
  maxSubCompanies  Int     @default(1)
  maxUsers         Int?
  isActive         Boolean @default(true)
  sortOrder        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planModules   PlanModule[]
  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

model PlanModule {
  planId   String
  moduleId String

  plan   Plan   @relation(fields: [planId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@id([planId, moduleId])
  @@index([moduleId])
  @@map("plan_modules")
}

// ─── Subscription (an Organization's relationship to a Plan over time) ─────

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextDueDate        DateTime?
  canceledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])
  payments     Payment[]

  @@index([organizationId])
  @@index([status])
  @@index([nextDueDate])
  @@map("subscriptions")
}

// ─── BankAccount (our bank details shown to tenants for manual transfer) ──

model BankAccount {
  id            String  @id @default(uuid())
  bankName      String
  accountTitle  String
  accountNumber String
  iban          String?
  branchCode    String?
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  payments Payment[]

  @@map("bank_accounts")
}

// ─── Payment (manual bank-transfer proof, verified by a PlatformAdmin) ────

model Payment {
  id                 String                    @id @default(uuid())
  organizationId     String
  subscriptionId     String?
  planId             String
  bankAccountId      String?
  amountClaimedPaisa BigInt
  periodStart        DateTime?
  periodEnd          DateTime?
  screenshotUrl      String
  transactionRef     String?
  status             PaymentVerificationStatus @default(PENDING)
  reviewedBy         String?
  reviewedAt         DateTime?
  rejectionReason    String?
  submittedAt        DateTime                  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  plan         Plan          @relation(fields: [planId], references: [id])
  bankAccount  BankAccount?  @relation(fields: [bankAccountId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([submittedAt])
  @@map("payments")
}

// ─── PlatformAdmin (BD Matrix backoffice login — separate from tenant Users) ─

model PlatformAdmin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  @@map("platform_admins")
}
